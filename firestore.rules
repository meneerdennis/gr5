rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // Hikes collection - read access for everyone, write restricted to admins
    match /hikes/{hikeId} {
      allow read: if true;
      // Admin-only writes: prevents anonymous or regular authenticated users from creating/updating/deleting hikes
      allow write: if isAdmin();
      match /likes/{uid} {
        // Allow read for everyone
        allow read;
        // Allow create/delete only by owner
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        // Allow read only if approved
        allow read: if resource.data.approved == true;
        // Allow create by authenticated users
        allow create: if request.auth != null;
        // Allow delete only by owner
        allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }
    
    match /quotes/{quote} {
      allow read: if true;  // Allow anyone to read quotes
      // Only administrators may write/modify quotes
      allow write: if isAdmin();
    }
    
    // Photos collection - reads public, writes restricted to admins (managed via AdminPhotoManager)
    match /photos/{document} {
      allow read: if true;
      // Only admins can create/update/delete photos
      allow create, update, delete: if isAdmin();
    }
    
    // User preferences - allow read and write only by the user themselves
    match /userPreferences/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // User FCM tokens - for PWA notifications (owner-only access)
    match /userTokens/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false; // Deny list operations (Cloud Functions use admin SDK)
    }

    // Notification log - admin writes only, no client access
    match /notificationLog/{logId} {
      allow read, write: if false; // Only Cloud Functions (admin SDK) can access
    }

    // Viewed activities - user-specific tracking
    match /viewedActivities/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    // Comment count feed for live bullets
    match /hikeCommentCounts/{hikeId} {
      allow read: if true;
      allow write: if false;
    }

    // Meta docs for lightweight change notifications
    match /meta/{docId} {
      allow read: if true; // Allow clients to listen to small change documents
      allow write: if false; // Only functions (admin SDK) should write
    }
  }
}